{
  "name": "portfolio-website",
  "version": "1.0.0",
  "private": true,
  "description": "Site estatico do portifolio do Joao Curcino. O CSS do Tailwind e pre-compilado para evitar o custo de runtime do CDN.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --watch",
    "build": "npm run build:css && node scripts/prepare-public.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}